          "name": "GET System Settings (All 6 Telegram Toggles & Zero Secret Leak)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('All 6 Telegram toggles & Ops fields present', () => {",
                  "  ['telegramAlertOnFailedLogin','telegramAlertOnRateLimit','telegramAlertOnAdminLogin','telegramAlertOnSettingsChange','telegramAlertOnServerError','telegramAlertOnBroadcast','maintenanceMode','announcementEnabled'].forEach(k => pm.expect(j).to.have.property(k));",
                  "});",
                  "pm.test('No raw secrets returned', () => { pm.expect(j).to.not.have.property('telegramBotToken'); pm.expect(j).to.not.have.property('smtpPassword'); pm.expect(j).to.not.have.property('aiApiKey'); });"
