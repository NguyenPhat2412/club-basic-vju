              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Admin login succeeds (200)\", () => pm.response.to.have.status(200));",
                  "const xsrf = pm.cookies.get(\"XSRF-TOKEN\"); if (xsrf) pm.environment.set(\"xsrfToken\", xsrf);",
                  "pm.test(\"User profile returned without password\", () => { const j = pm.response.json(); pm.expect(j.user || j).to.have.property(\"email\"); });",
                  "pm.test(\"Session cookie is HttpOnly\", () => { const setCookie = pm.response.headers.all().filter(h => h.key.toLowerCase() === \"set-cookie\").map(h => h.value).join(\";\"); pm.expect(setCookie.toLowerCase()).to.include(\"httponly\"); });"
                ]
              }
