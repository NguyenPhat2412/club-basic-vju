      "name": "02. Auth, Session & Security Negative Tests",
      "item": [
        {
          "name": "GET Bootstrap CSRF Token (/auth/csrf)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 or 204\", () => pm.expect([200, 204]).to.include(pm.response.code));",
                  "const cookieVal = pm.cookies.get(\"XSRF-TOKEN\");",
                  "let bodyToken = null;",
                  "try { bodyToken = pm.response.json().token; } catch (e) {}",
                  "const token = cookieVal || bodyToken;",
                  "pm.test(\"CSRF token issued\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
                  "if (token) pm.environment.set(\"xsrfToken\", token);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/csrf"
          }
        },
        {
          "name": "[Negative] Unauthenticated System Settings -> 401",
