# Copy to /srv/vju-club/deploy/.env on the VPS (chmod 600). Never commit the real file.
FRONTEND_HOST=vju-club.all1.vn
API_HOST=api.vju-club.all1.vn
# Parent domain of both hosts: lets the frontend read the API's XSRF-TOKEN cookie.
COOKIE_DOMAIN=vju-club.all1.vn
# Loopback ports the host nginx proxies to (deploy/nginx/vju-club.conf).
FRONTEND_PORT=3110
BACKEND_PORT=8110

POSTGRES_PASSWORD=<long random password>

# First administrator, created on the first start only. Remove both lines after signing in.
BOOTSTRAP_ADMIN_EMAIL=<admin email>
BOOTSTRAP_ADMIN_PASSWORD=<strong password>

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=club-basic-vju
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>

# Optional: 9router / OpenAI-compatible LLM provider for Chat AI Summarizer.
# If AI_API_KEY is left empty, backend automatically falls back to built-in extractive summarizer.
AI_BASE_URL=https://router.anhchau.all1.vn/v1
AI_API_KEY=<9router api key>
AI_MODEL=apmarket

# Sign in with a school Google account (Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID, type "Web application", authorised JavaScript origin https://vju-club.all1.vn).
# Leave empty to keep Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=st.vju.ac.vn

# Facebook Fanpage integration (AES-256-GCM key for encrypting Page Access Tokens at rest).
# Always set a unique 32+ char random secret for FACEBOOK_TOKEN_ENCRYPTION_KEY on Production/Stagging.
FACEBOOK_TOKEN_ENCRYPTION_KEY=<long random 32+ char secret>
# Optional: enable 1-click Facebook OAuth login in Club Settings (leave empty to use Page Token mode only).
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v22.0
FACEBOOK_OAUTH_REDIRECT_URI=https://api.vju-club.all1.vn/api/v1/integrations/facebook/oauth/callback
FRONTEND_BASE_URL=https://vju-club.all1.vn

# HMAC secret for event attendance QR tokens (must be >= 16 characters; otherwise restarts invalidate active QR tokens).
APP_QR_SECRET=<long random 32+ char secret>

# API & upload rate limiting defaults (requests per window configured in application.yml).
RATE_LIMIT_MAX_REQUESTS=15
RATE_LIMIT_WRITE_MAX_REQUESTS=60
RATE_LIMIT_CHAT_UPLOAD_MAX_REQUESTS=15
