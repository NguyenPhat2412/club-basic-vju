# Copy to /srv/vju-club/deploy/.env on the VPS (chmod 600). Never commit the real file.
FRONTEND_HOST=vju-club.all1.vn
API_HOST=api.vju-club.all1.vn
# Parent domain of both hosts: lets the frontend read the API's XSRF-TOKEN cookie.
COOKIE_DOMAIN=vju-club.all1.vn
# Loopback ports the host nginx proxies to (deploy/nginx/vju-club.conf).
FRONTEND_PORT=3110
BACKEND_PORT=8110

POSTGRES_PASSWORD=<long random password>

# First administrator, created on the first start only. Remove both lines after signing in.
BOOTSTRAP_ADMIN_EMAIL=<admin email>
BOOTSTRAP_ADMIN_PASSWORD=<strong password>

R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=club-basic-vju
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
