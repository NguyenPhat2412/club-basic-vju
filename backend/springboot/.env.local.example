# Copy to .env.local (same folder) and fill in your own values. .env.local is git-ignored.
# Read automatically when the backend runs with the "local" profile, on macOS and Windows alike.

# Admin account created on first start (gets the SYSTEM_ADMIN role).
BOOTSTRAP_ADMIN_EMAIL=admin@vju.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Password for the demo users demo.a/b/c@vju.local; leave empty to skip the demo club VJUA.
DEMO_USER_PASSWORD=change-me-demo-password

# Only if PostgreSQL does not listen on localhost:5432 (e.g. POSTGRES_PORT=5433 for docker compose).
# DB_URL=jdbc:postgresql://localhost:5433/club
